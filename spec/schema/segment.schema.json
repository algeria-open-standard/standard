{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aos:spec:0.1:segment",
  "title": "AOS 0.1, en-tête de segment (segment.json)",
  "type": "object",
  "required": ["aos", "format", "sequence", "id", "createdAt", "issuer", "previous", "parts"],
  "additionalProperties": false,
  "properties": {
    "aos": { "const": "0.1" },
    "format": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "id": { "type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "issuer": { "$ref": "#/$defs/party" },
    "producer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string" } }
    },
    "previous": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["sequence", "digest"],
          "additionalProperties": false,
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 },
            "digest": { "$ref": "#/$defs/digest" },
            "checkedAt": { "type": "string", "format": "date-time" },
            "seals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["keyId", "cryptographic", "trust"],
                "additionalProperties": false,
                "properties": {
                  "keyId": { "type": ["string", "null"] },
                  "cryptographic": { "enum": ["valid", "invalid"] },
                  "trust": { "enum": ["trusted", "unknown-key", "holder-mismatch", "outside-validity", "revoked", "not-checked"] }
                }
              }
            }
          }
        }
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "mediaType", "size", "digest"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^(parts|files)/[^\\\\]+$" },
          "type": { "type": "string", "pattern": "^(file|[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*|x-[a-z0-9.-]+)$" },
          "mediaType": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha-(256|384|512):[0-9a-f]+$" },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": { "scheme": { "type": "string", "pattern": "^[a-z]{2,}(:[a-z0-9-]+)+$|^x-[a-z0-9:.-]+$" }, "value": { "type": "string", "minLength": 1, "maxLength": 64 } }
    },
    "party": {
      "type": "object",
      "required": ["name", "country", "identifiers"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "identifiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } }
      }
    }
  }
}
